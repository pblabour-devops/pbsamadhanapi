@using pbsamadhannetcoreapi.ViewModels
@model TemplateInspectionSubmittedNotificationViewModel
<!DOCTYPE html>
<html lang="en" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml">
<head>
    <title></title>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600&display=swap');

        table {
            font-family: arial, sans-serif;
            border-collapse: collapse;
            width: 100%;
        }

        td, th {
            border: 1px solid #dddddd;
            text-align: left;
            padding: 8px;
        }

        tr:nth-child(even) {
            /*background-color: #dddddd;*/
        }

        .text-danger {
            color: red;
        }

        .signature {
            font-weight: 600;
        }

        th {
            background-color: green;
            color: white;
        }
    </style>
</head>
<body style="background-color: #fff; margin: 0; padding: 0; -webkit-text-size-adjust: none; text-size-adjust: none;">
    Dear Applicant, <br />
    <br />
    <table>
        <tr>
            <th>Establishment Name</th>
            <td>@Model.EstablishmentName</td>
        </tr>
        <tr>
            <th>Address</th>
            <td>@Model.EstablishmentAddress</td>
        </tr>
        <tr>
            <th>License No.</th>
            <td>@Model.LicenseNumber</td>
        </tr>
    </table>

    This email is generated to inform you that your establishment has been inspected by  @Model.RoleName @Model.FactoryCircle (@Model.OfficerName) under
    @{
        if (Model.InspectionType == 1)
        {
            @:(factory laws)
        }
        else
        {
            @:(labour laws)
        }
    }

    on @Model.InspectionDate.ToString(). As per inspection submitted your establishment is @Model.FactoryStatus.
    @{
        if (Model.IsViolationFound > 1)
        {
            @:Some
        }
        else
        {
            @:No
        }
    }
    violations have been found. Dear Applicant, Please visit <a href="https://pbindustries.gov.in/webportal/login" target="_blank">https://pbindustries.gov.in/webportal/login</a> to check your inspection report and violation report.
    <br /><br />
    <div>
        <p class="text-danger"> Note : If any kind of violation is found in inpection then you have only 30 days(From date of inspection submitted by officer) to submit your compliance report.</p>
    </div>


    <div class="signature">
        <p>Thanks & Regards, <br /> Team, Department Of Labour <br /> Model Welfare Centre,<br />Phase 10, Sector 64,<br /> Sahibzada Ajit Singh Nagar,<br /> Punjab 160062 <br /> 91-172-2702486</p>
    </div>

    <div>
        <p class="text-danger"> Note : Do not reply to this message because this email is an automated notification, which is unable to receive replies. Replies to this email are routed to an unmonitored mailbox.</p>
    </div>
</body>
</html>
