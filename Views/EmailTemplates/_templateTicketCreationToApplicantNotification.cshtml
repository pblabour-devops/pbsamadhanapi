@using pbsamadhannetcoreapi.ViewModels
@model TemplateTicketCreationToApplicantNotificationViewModel
<!DOCTYPE html>
<html lang="en" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml">
<head>
    <title>eLabour Portal Notification</title>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600&display=swap');
        body {
            font-family: 'Poppins', Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f7f7f7;
        }

        .container {
            background-color: #ffffff;
            border-radius: 10px;
            padding: 25px;
            margin-top: 40px;
            box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.1);
            border-left: 8px solid #4CAF50; /* Stylish green border */
            width: 80%;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
			padding-top:20px;
        }

        .header {
            font-size: 24px;
            font-weight: 700;
            color: #333;
            margin-bottom: 10px;
        }

        .subheader {
            font-size: 18px;
            color: #555;
            margin-bottom: 20px;
        }

        p {
            color: #333;
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .signature {
            font-weight: 600;
            margin-top: 20px;
            font-size: 14px;
            color: #555;
        }

        .text-danger {
            color: red;
            font-weight: bold;
            margin-top: 20px;
        }

        /* Table styling */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 30px;
            border-radius: 8px;
            overflow: hidden;
        }

        td, th {
            padding: 15px;
            text-align: left;
            font-size: 16px;
            color: #333;
        }

        th {
            background-color: #1e90ff;
            color: white;
            font-weight: bold;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        tr:nth-child(odd) {
            background-color: #f1f1f1;
        }

        .table-header {
            background-color: #4CAF50; /* Green header */
            color: white;
            text-align: center;
        }

        .table-body td {
            color: #333;
        }

        .table-body td.center {
            text-align: center;
        }

        /* Footer Section */
        .footer {
            margin-top: 40px;
            font-size: 14px;
            color: #777;
            text-align: center;
        }

        .important {
            color: #ff5722;
        }

        .container a {
            color: #4CAF50;
            text-decoration: none;
            font-weight: bold;
        }
        .container a:hover {
            text-decoration: underline;
        }
        .ticket-Id {
            font-weight: bold;
            font-style: italic;
            color: blue;
        }
    </style>
</head>
<body>
    <div class="container">
        <p class="header">Greetings from eLabour Portal,</p>
        <p class="subheader">Thank you for visiting and applying for service on the eLabour portal. Our system observed that you had faced some issues while performing some actions on the portal. Our system has created and assigned a ticket (<span class="ticket-Id">Ticket# : @Model.RootActivityRefId </span>) to the concerned technical team.</p>

        <p>We apologize for the inconvenience caused to you, and we assure you that as soon as possible, the issue will be resolved. Our helpdesk team will inform you of the further action.</p>

        <p>For more information, kindly contact the helpdesk team.</p>

        <p>We appreciate your time and patience.</p>

        <div class="signature">
            <p>
                Thanks & Regards,<br />
                Team, Department Of Labour <br />
                Model Welfare Centre,<br />
                Phase 10, Sector 64,<br />
                Sahibzada Ajit Singh Nagar,<br />
                Punjab 160062 <br />
                Technical Helpdesk Contact - Mobile : 91-9814551313, Email : elabourhelpdesk@gmail.com<br />
            </p>
        </div>

        <div>
            <p class="text-danger">Note: Do not reply to this message because this email is an automated notification, which is unable to receive replies. Replies to this email are routed to an unmonitored mailbox.</p>
        </div>
    </div>
</body>
</html>
